# ==========================================================
# Environment configuration template
# Copy this file to `.env` and adjust the values.
# Never commit the real `.env` file.
# ==========================================================

# ---------- Backend ----------
APP_NAME="Digital Warehouse Operations and Fulfillment Platform"
APP_ENV=development
LOG_LEVEL=INFO

# SQLite database file (relative to the project root)
DATABASE_URL=sqlite:///./database/warehouse.db

# Security. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with the default key unless APP_ENV is development or test.
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=digital-warehouse-platform
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password hashing cost (bcrypt). Higher = slower and harder to brute-force.
BCRYPT_ROUNDS=12
# HTTPS-only refresh cookie. Automatic when not set: off in development/test, on elsewhere.
# COOKIE_SECURE=true

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite) ----------
# Variables used by the frontend must start with VITE_
VITE_API_BASE_URL=http://localhost:8000/api/v1
